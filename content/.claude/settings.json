{
  "autoMemoryEnabled": false,
  "permissions": {
    "additionalDirectories": [
      "C:\\Users\\mehul\\DND\\DesignLibrary\\Export",
      "C:\\Users\\mehul\\DND\\dnd-audio-transcription\\state\\briefs"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(/Private Notes/**)",
      "Skill(cycle)",
      "Skill(session-summary)",
      "Skill(prep)",
      "Skill(lore)",
      "Skill(magic-item)",
      "Skill(statblock)",
      "Skill(proto-map)",
      "Skill(glossary)",
